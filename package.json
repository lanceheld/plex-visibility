{
  "name": "plex-visibility",
  "version": "0.2.0",
  "description": "Monitors Plex Media Server remote access and alerts when the server is not reachable from the internet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types server/src/index.ts & vite --config web/vite.config.ts",
    "build": "tsc -p server && tsc -p web --noEmit && vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npx better-npm-audit audit --production",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "better-npm-audit": "^4.2.1",
    "lucide-react": "^1.79.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
